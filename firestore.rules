rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'dip92599@gmail.com');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'highestLevel', 'totalScore', 'starsEarned', 'currentStreak', 'puzzlesSolved']) &&
             data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'highestLevel', 'totalScore', 'starsEarned', 'currentStreak', 'puzzlesSolved', 'updatedAt', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             data.highestLevel is int && data.highestLevel >= 1 &&
             data.totalScore is int && data.totalScore >= 0 &&
             data.starsEarned is int && data.starsEarned >= 0 &&
             data.currentStreak is int && data.currentStreak >= 0 &&
             data.puzzlesSolved is int && data.puzzlesSolved >= 0;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'displayName', 'score', 'highestLevel', 'stars']) &&
             data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'score', 'highestLevel', 'stars', 'updatedAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             data.score is int && data.score >= 0 &&
             data.highestLevel is int && data.highestLevel >= 1 &&
             data.stars is int && data.stars >= 0;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Private profiles, no listing

      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserProfile(incoming());

      allow update: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId;

      allow delete: if isOwner(userId);
    }

    // Leaderboard Collection - public read, owner write
    match /leaderboard/{userId} {
      allow get: if true;
      allow list: if true;

      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().userId == existing().userId;

      allow delete: if isOwner(userId);
    }

    // VIP Payment Requests Collection
    function isValidVipRequest(data) {
      return data.keys().hasAll(['id', 'name', 'number', 'utr', 'amount', 'plan', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.number is string && data.number.size() > 0 && data.number.size() <= 30 &&
             data.utr is string && data.utr.size() >= 6 && data.utr.size() <= 40 &&
             data.amount is int && data.amount > 0 &&
             data.plan is string && (data.plan == 'monthly' || data.plan == 'lifetime') &&
             data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected');
    }

    match /vip_requests/{requestId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isValidVipRequest(incoming()) && incoming().status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
